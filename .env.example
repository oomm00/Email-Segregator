# Database
DATABASE_URL=postgresql+asyncpg://shipping:shipping_secret@postgres:5432/shipping_email

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ / Celery
CELERY_BROKER_URL=amqp://shipping:shipping_secret@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Elasticsearch
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=shipping_access
MINIO_SECRET_KEY=shipping_secret
MINIO_BUCKET=shipping-attachments
MINIO_SECURE=false

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET_KEY=change-me-in-production-jwt-secret
CORS_ORIGINS=*
